# Copy to .env.local and fill in values. Never commit .env or .env.local.
# Names only here: no values, tokens or keys in this file.

# --- Quote form submission route (app/api/quote/route.js) ---
# Optional. Leave empty to post to /api/quote/ on this site. Set it only to send the
# form to another intake. The form always falls back to a prefilled email if the post fails.
NEXT_PUBLIC_QUOTE_ENDPOINT=

# Supabase: durable storage of every lead (table public.betranslated_uk_quote_submissions,
# see supabase/migrations/) and the private lead-uploads bucket for attachments.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email notification (Resend). All three are needed; otherwise no email is sent.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=
QUOTE_NOTIFY_EMAIL=

# Switch: mirror each lead into the BT-Digital ops.leads table (set to 1 to enable).
QUOTE_MIRROR_OPS_LEADS=

# Switch: post the lead card to Slack (set to 1 to enable; needs the mirror above).
QUOTE_SLACK_ENABLED=
SLACK_BOT_TOKEN=
SLACK_LEADS_CHANNEL_ID=
# Optional: origin of the BT-Digital dashboard for the "Open lead profile" link.
NEXT_PUBLIC_DASHBOARD_ORIGIN=

# Cloudflare Turnstile (optional anti-spam). Set both to switch it on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
